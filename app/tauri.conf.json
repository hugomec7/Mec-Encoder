{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mec Encoder",
  "version": "0.1.1",
  "identifier": "com.hugomec.mecencoder",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mec Encoder",
        "width": 1320,
        "height": 820,
        "minWidth": 1060,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Hugo Mec",
    "copyright": "© Hugo Mec",
    "category": "Video",
    "shortDescription": "Fast, minimal NVENC video converter",
    "longDescription": "Mec Encoder converts iPhone and camera footage with NVIDIA NVENC: constant frame rate, proxies, HDR to Rec. 709.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": ["bin/*"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "wix": { "language": "en-US" }
    }
  }
}
