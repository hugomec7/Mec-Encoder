{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "1.3.0",
  "default_locale": "en",
  "homepage_url": "https://github.com/hugomec7/Mec-Encoder",
  "icons": { "32": "icons/32.png", "48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png" },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "background": { "scripts": ["background.js"] },
  "permissions": ["nativeMessaging", "contextMenus", "activeTab", "scripting", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": { "id": "mec-encoder@hugomec", "strict_min_version": "128.0" }
  }
}
